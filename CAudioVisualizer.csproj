<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' != '' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Disable aggressive trimming for audio libraries -->
    <PublishTrimmed>false</PublishTrimmed>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="OpenTK" />
    <TrimmerRootAssembly Include="OpenTK.Audio.OpenAL" />
    <TrimmerRootAssembly Include="OpenTK.Graphics" />
    <TrimmerRootAssembly Include="OpenTK.Input" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAudio is only used on Windows at runtime, but it is referenced for every platform
         so that Windows executables can be built from Linux as well. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="ImGui.NET" Version="1.91.0.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!-- Preserve NAudio and related assemblies from trimming -->
  <ItemGroup>
    <TrimmerRootAssembly Include="NAudio" />
    <TrimmerRootAssembly Include="NAudio.Core" />
    <TrimmerRootAssembly Include="NAudio.Wasapi" />
    <TrimmerRootAssembly Include="NAudio.WinMM" />
    <TrimmerRootAssembly Include="NAudio.Asio" />
  </ItemGroup>

</Project>
